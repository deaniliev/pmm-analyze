PMM_CONTAINER_NAME="pmm-server"
PMM_URL="https://localhost:8443"
PMM_USER="admin"
PMM_PASS="super-duper-strong-password"

CLICKHOUSE_USER="default"
CLICKHOUSE_PASS="clickhouse"

USE_AI=False
AI_API_KEY="your_api_key_here"

#OUTPUT_DATA_FILE="pmm_telemetry.json"
OUTPUT_DATA_FILE="pmm_telemetry.json"

# Time window defaults, overridable with --start / --end / --last / --step.
# START_TIME and END_TIME accept "YYYY-MM-DD", "YYYY-MM-DD HH:MM[:SS]", a UNIX timestamp or "now".
# When START_TIME is empty, the window is LAST_PERIOD back from END_TIME (default: now).
#START_TIME="2026-08-10 09:00"
#END_TIME="2026-08-12 18:00"
LAST_PERIOD="3d"
STEP="300s"
